{
  "name": "rentnest-backend",
  "version": "1.0.0",
  "description": "RentNest - Hyperlocal Peer-to-Peer Rental Platform Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:prod": "node server.js",
    "dev": "nodemon server.js",
    "build": "cd ../frontend && npm install && npx expo export --platform web --output-dir dist",
    "test:web": "node ./e2e/selenium/webE2eTests.js",
    "test:mobile": "node ./e2e/appium/mobileE2eTests.js",
    "test:full": "node ./e2e/testRunner.js",
    "test:summary": "node ./e2e/testSummary.js",
    "test:all": "node ./e2e/selenium/webE2eTests.js && node ./e2e/appium/mobileE2eTests.js && node ./e2e/testRunner.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "mongoose-paginate-v2": "^1.7.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "qrcode": "^1.5.3",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "selenium-webdriver": "^4.15.3",
    "wd": "^1.14.0",
    "xlsx": "^0.18.5"
  }
}
